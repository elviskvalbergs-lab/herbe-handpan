{
  "buildCommand": "python3 build.py",
  "outputDirectory": ".",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/play",
      "destination": "/"
    },
    {
      "source": "/handpan/:path*",
      "destination": "/"
    },
    {
      "source": "/tongue-drum/:path*",
      "destination": "/"
    },
    {
      "source": "/ocarina/:path*",
      "destination": "/"
    },
    {
      "source": "/flute/:path*",
      "destination": "/"
    },
    {
      "source": "/s/:path*",
      "destination": "/"
    }
  ],
  "redirects": [
    {
      "source": "/privacy",
      "destination": "https://oakhum.com/privacy",
      "permanent": false
    }
  ]
}
