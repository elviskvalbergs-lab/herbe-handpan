{
  "buildCommand": "python3 build.py",
  "outputDirectory": ".",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/play",
      "destination": "/"
    },
    {
      "source": "/handpan/:path*",
      "destination": "/"
    },
    {
      "source": "/tongue-drum/:path*",
      "destination": "/"
    },
    {
      "source": "/kalimba/:path*",
      "destination": "/"
    },
    {
      "source": "/ocarina/:path*",
      "destination": "/"
    },
    {
      "source": "/flute/:path*",
      "destination": "/"
    },
    {
      "source": "/s/:path*",
      "destination": "/"
    }
  ],
  "redirects": [
    {
      "source": "/docs/:path*",
      "destination": "/play",
      "permanent": false
    },
    {
      "source": "/supabase/:path*",
      "destination": "/play",
      "permanent": false
    },
    {
      "source": "/tests/:path*",
      "destination": "/play",
      "permanent": false
    },
    {
      "source": "/scripts/:path*",
      "destination": "/play",
      "permanent": false
    },
    {
      "source": "/spikes/:path*",
      "destination": "/play",
      "permanent": false
    },
    {
      "source": "/site/:path*",
      "destination": "/play",
      "permanent": false
    },
    {
      "source": "/CLAUDE.md",
      "destination": "/play",
      "permanent": false
    },
    {
      "source": "/build.py",
      "destination": "/play",
      "permanent": false
    },
    {
      "source": "/server.sh",
      "destination": "/play",
      "permanent": false
    },
    {
      "source": "/bitbucket-pipelines.yml",
      "destination": "/play",
      "permanent": false
    },
    {
      "source": "/privacy",
      "destination": "https://oakhum.com/privacy",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
